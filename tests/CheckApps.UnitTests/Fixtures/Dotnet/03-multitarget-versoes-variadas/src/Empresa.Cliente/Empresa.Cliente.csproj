<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <HttpVersion>8.0.2</HttpVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Literal. -->
    <PackageReference Include="Polly" Version="8.4.0" />
    <!-- Versão em elemento filho, não em atributo. -->
    <PackageReference Include="Humanizer.Core">
      <Version>2.14.1</Version>
    </PackageReference>
    <!-- Propriedade definida neste mesmo arquivo: resolve. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(HttpVersion)" />
    <!-- Propriedade que não existe em lugar nenhum: fica o texto cru. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(VersaoQueNaoExiste)" />
    <!-- Flutuante e intervalo: guardados como declarados. -->
    <PackageReference Include="AutoMapper" Version="13.*" />
    <PackageReference Include="FluentValidation" Version="[11.0,12.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <!-- A condição não é avaliada: o item entra mesmo assim (limite conhecido). -->
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

</Project>
